# MachineGuard AI Environment Configuration

# Database (PostgreSQL in production/Docker, SQLite default locally)
DATABASE_URL=sqlite:///./machineguard.db
# DATABASE_URL=postgresql://machineguard:machineguard_secure_pwd@localhost:5432/machineguard_db

# Redis & Celery Message Broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Distributed Worker Timers
WORKER_HEARTBEAT_TIMEOUT_SEC=15
JOB_LEASE_TIMEOUT_SEC=25
MAX_JOB_ATTEMPTS=3

# Security
SECRET_KEY=machineguard-super-secret-key-for-hackathon-2026
DEBUG=True
